{
  "name": "LifeChaordic",
  "short_name": "LifeChaordic",
  "description": "A calm planner for tasks, bills, appointments, shopping and routines.",
  "id": "./",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b1d3a",
  "theme_color": "#0b1d3a",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick Capture", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./#tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
